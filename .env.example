# ============================================================================
# FHIR IPS Bundle Validator - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your credentials
# 
# IMPORTANT: Never commit .env file to git (already in .gitignore)
# ============================================================================

# ============================================================================
# AZURE FHIR SERVICE CONFIGURATION
# ============================================================================
# Azure Health Data Services FHIR API credentials
# Required for: Azure FHIR validator
# Get credentials from: Azure Portal → Your FHIR Service → Authentication

# Your Azure FHIR service URL (without https://)
# Example: myhealth-fhir.fhir.azurehealthcareapis.com
AZURE_FHIR_BASE_URL=

# Service Principal Application (Client) ID
# Example: 12345678-1234-1234-1234-123456789abc
AZURE_FHIR_CLIENT_ID=

# Service Principal Client Secret
# Example: abc123~DEF456-GHI789.JKL012
AZURE_FHIR_CLIENT_SECRET=

# Azure Active Directory Tenant ID
# Example: 87654321-4321-4321-4321-abcdefghijkl
AZURE_FHIR_TENANT_ID=

# ============================================================================
# eHDSI GAZELLE PLATFORM CONFIGURATION (Original)
# ============================================================================
# eHDSI Gazelle platform for CDA Wave 7-10 validation
# Required for: Gazelle EVS validator (eHDSI platform option)
# Get API key from: https://gazelle.ehdsi.eu/gazelle/user-management/api-keys

# Base URL for eHDSI Gazelle platform
EVS_BASE_URL=https://gazelle.ehdsi.eu

# Your eHDSI Gazelle API key
# Example: JXw21yMdi8aT1dP5PKuJNwzjRX3kkiAWRgUhF4jty8HsN17oyuJVi2ZhT6aWxQj7iT7Inj9yPApoF80lRDKBkZw1K3c6poLXrHsx46D1Nn3HKjz1ibyVZrkDpl3tRAiF
EVS_API_KEY=

# Optional: API key expiry date (for tracking/warnings)
# Format: MM/DD/YY HH:MM:SS AM/PM (TIMEZONE)
# Example: 6/15/26 2:00:00 AM (CEST GMT+0200)
EVS_API_KEY_EXPIRY_DATE=

# ============================================================================
# EHDS GAZELLE PLATFORM CONFIGURATION (New)
# ============================================================================
# EHDS Gazelle platform for modern HL7 EU standards
# Required for: Gazelle EVS validator (EHDS platform option) & EHDS Matchbox
# Get API key from: https://ehds.gazelle-platform.net/gazelle/user-management/api-keys

# Base URL for EHDS Gazelle platform
EHDS_GAZELLE_BASE_URL=https://ehds.gazelle-platform.net

# Your EHDS Gazelle API key
# Example: 3ZOyRTtRgTi9ppjnUVP6w31AoAmWPNhahMTQITF2c6cJaVdwHDxiCZ1Af6csrmsPRwNWoLBVTM7d6WdzvoHn2xHKoXq59nXd7exVHIRSuEwWSDtEpoO6lZsrynkoV8E7
EHDS_GAZELLE_API_KEY=

# Optional: API key expiry date (for tracking/warnings)
# Format: MM/DD/YY HH:MM:SS AM/PM (TIMEZONE)
# Example: 6/16/26 12:00:00 AM (CEST GMT+0200)
EHDS_GAZELLE_API_KEY_EXPIRY_DATE=

# ============================================================================
# APPLICATION CONFIGURATION (Optional)
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Maximum file size for uploads (in MB)
# Default: 10
MAX_FILE_SIZE_MB=10

# API timeout in seconds
# Default: 60
API_TIMEOUT_SECONDS=60

# Azure FHIR Service Configuration
# Get these from your Azure Health Data Services FHIR service
AZURE_FHIR_BASE_URL=https://your-fhir-service.fhir.azurehealthcareapis.com
AZURE_FHIR_TENANT_ID=your-azure-tenant-id
AZURE_FHIR_SUBSCRIPTION_ID=your-subscription-id
AZURE_FHIR_RESOURCE_GROUP=your-resource-group
AZURE_FHIR_WORKSPACE=your-workspace-name
AZURE_FHIR_SERVICE_NAME=your-fhir-service-name

# Service Principal Authentication (recommended for automation)
# Create with: az ad sp create-for-rbac --name "fhir-validator"
AZURE_FHIR_CLIENT_ID=your-service-principal-client-id
AZURE_FHIR_CLIENT_SECRET=your-service-principal-secret
