# ============================================================================
# FHIR IPS Bundle Validator - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your Azure credentials (optional)
# 
# IMPORTANT: 
# - Never commit .env file to git (already in .gitignore)
# - Most validators are PUBLIC and require NO configuration
# - Only Azure FHIR requires credentials (optional for production use)
# ============================================================================

# ============================================================================
# PUBLIC VALIDATORS (No Configuration Required)
# ============================================================================
# The following validators work without any API keys or credentials:
# 
# ✅ EHDS Matchbox (DEFAULT)
#    - URL: https://ehds.gazelle-platform.net/matchboxv3/fhir
#    - Validates: FHIR IPS bundles with 21 specialized profiles
#    - Authentication: None required (public service)
#    - File size: Up to 10MB tested
# 
# ✅ HAPI FHIR Public Server
#    - URL: http://hapi.fhir.org/baseR4
#    - Validates: Generic FHIR R4 resources
#    - Authentication: None required (public test server)
#    - File size: Limited to ~50KB (public server constraint)
# 
# ✅ Gazelle EVS (eHDSI & EHDS)
#    - URLs: gazelle.ehdsi.eu, ehds.gazelle-platform.net
#    - Validates: CDA documents via SOAP (49+ validators)
#    - Authentication: None required (anonymous SOAP validation)
#    - File size: Up to 10MB tested
# 
# ============================================================================

# ============================================================================
# AZURE FHIR SERVICE CONFIGURATION (Optional - For Production)
# ============================================================================
# Only required if you want to use your private Azure FHIR service
# for HIPAA/GDPR-compliant validation of sensitive patient data.
# 
# Get credentials from: Azure Portal → Your FHIR Service → Authentication
# 
# Setup instructions:
# 1. Create Service Principal: az ad sp create-for-rbac --name "fhir-validator"
# 2. Grant FHIR Data Contributor role to the service principal
# 3. Copy the credentials below

# Your Azure FHIR service URL (without https://)
# Example: myhealth-fhir.fhir.azurehealthcareapis.com
AZURE_FHIR_BASE_URL=

# Service Principal Application (Client) ID
# Example: 12345678-1234-1234-1234-123456789abc
AZURE_FHIR_CLIENT_ID=

# Service Principal Client Secret
# Example: abc123~DEF456-GHI789.JKL012
AZURE_FHIR_CLIENT_SECRET=

# Azure Active Directory Tenant ID
# Example: 87654321-4321-4321-4321-abcdefghijkl
AZURE_FHIR_TENANT_ID=

# ============================================================================
# APPLICATION CONFIGURATION (Optional)
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Maximum file size for uploads (in MB)
# Default: 10
MAX_FILE_SIZE_MB=10

# API timeout in seconds
# Default: 60
API_TIMEOUT_SECONDS=60
