# eHDSI Gazelle API Configuration
# Get your API key from: https://gazelle.ehdsi.eu/gazelle/user-management/registration
EVS_API_KEY=your_gazelle_api_key_here
EVS_API_KEY_CREATION_DATE=
EVS_API_KEY_EXPIRY_DATE=
EVS_BASE_URL=https://gazelle.ehdsi.eu
EVS_SESSION_TIMEOUT=3600

# Validation Settings
DEFAULT_VALIDATOR=hl7-eu-hospital-discharge
STRICT_MODE=false
MAX_BATCH_SIZE=50

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/validator.log
LOG_FORMAT=json

# API Rate Limiting
RATE_LIMIT_CALLS=60
RATE_LIMIT_PERIOD=60

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL=3600
CACHE_DIR=.cache

# Output Settings
DEFAULT_OUTPUT_FORMAT=json
COLORIZE_OUTPUT=true

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT=30

# Development
DEBUG=false
MOCK_API=false

# FHIR Provider Selection
# Options: AZURE, HAPI, LOCAL
FHIR_PROVIDER=AZURE

# Azure SQL Database Configuration (optional)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your_database
AZURE_SQL_USER=your_username
AZURE_SQL_PASSWORD=your_password
AZURE_SQL_PORT=1433

# Azure FHIR Service Configuration
# Get these from your Azure Health Data Services FHIR service
AZURE_FHIR_BASE_URL=https://your-fhir-service.fhir.azurehealthcareapis.com
AZURE_FHIR_TENANT_ID=your-azure-tenant-id
AZURE_FHIR_SUBSCRIPTION_ID=your-subscription-id
AZURE_FHIR_RESOURCE_GROUP=your-resource-group
AZURE_FHIR_WORKSPACE=your-workspace-name
AZURE_FHIR_SERVICE_NAME=your-fhir-service-name

# Service Principal Authentication (recommended for automation)
# Create with: az ad sp create-for-rbac --name "fhir-validator"
AZURE_FHIR_CLIENT_ID=your-service-principal-client-id
AZURE_FHIR_CLIENT_SECRET=your-service-principal-secret
