      <!-- History of Present Illness -->
      <component>
        <section>
          <code code="10164-2" codeSystem="2.16.840.1.113883.6.1" 
                displayName="History of present illness"/>
          <title>History of Present Illness</title>
          <text>
            <paragraph>
              58-year-old female presented to emergency department with acute onset chest pain 
              radiating to left arm, associated with dyspnea. Symptoms started approximately 
              2 hours prior to arrival. Patient has history of hypertension and type 2 diabetes.
            </paragraph>
          </text>
        </section>
      </component>
      
      <!-- Hospital Course -->
      <component>
        <section>
          <code code="8648-8" codeSystem="2.16.840.1.113883.6.1" 
                displayName="Hospital course"/>
          <title>Hospital Course</title>
          <text>
            <paragraph>
              Patient was admitted to the cardiac care unit. ECG showed ST-segment elevation 
              in leads II, III, and aVF consistent with inferior wall myocardial infarction. 
              Cardiac enzymes were elevated (Troponin I 2.5 ng/mL).
            </paragraph>
            <paragraph>
              Patient underwent emergency cardiac catheterization which revealed 95% stenosis 
              of right coronary artery. Successful percutaneous coronary intervention with 
              drug-eluting stent placement was performed.
            </paragraph>
            <paragraph>
              Post-procedure course was uneventful. Patient remained hemodynamically stable. 
              Echocardiography showed preserved left ventricular function with EF 55%.
            </paragraph>
          </text>
        </section>
      </component>
      
