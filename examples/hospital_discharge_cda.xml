          <title>Discharge Diagnosis</title>
          <text>
            <list>
              <item>Acute ST-elevation myocardial infarction (STEMI) - inferior wall</item>
              <item>Coronary artery disease with successful PCI and stent to RCA</item>
              <item>Type 2 Diabetes Mellitus</item>
              <item>Essential Hypertension</item>
            </list>
          </text>
